  "beta1": 0.5,
  "beta2": 0.999,
  "lambda_l1": 100.0,
  "horizontal_flip": true,
  "optimizer": "adam",
  "parameter_precision": "fp32",
  "precision": "fp32",
  "checkpoint_every": 4040,
  "extra_checkpoint_steps": [
    404,
    1010,
    2020
  ],
  "log_every": 202,
  "seed": 42,
  "num_workers": 4
