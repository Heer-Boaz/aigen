{
  "format": "aigen.pix2pix.training.v6",
  "objective": "adversarial_l1",
  "model": {
    "image_size": 128,
    "input_channels": 3,
    "output_channels": 3,
    "generator_channels": 92,
    "discriminator_channels": 64,
    "discriminator_layers": 3,
    "generator_dropout": true
  },
  "discriminator_scales": 2,
  "lambda_feature_matching": 10.0,
  "reconstruction_balance": "white_canvas_equal_regions",
  "adversarial_balance": "white_canvas_equal_regions",
  "discriminator_augmentation": "translation",
  "batch_size": 1,
  "max_steps": 38000,
  "learning_rate": 0.0002,
  "learning_rate_schedule": {
    "type": "linear_decay",
    "decay_start_step": 19000
  },
  "beta1": 0.5,
  "beta2": 0.999,
  "lambda_l1": 100.0,
  "horizontal_flip": true,
  "optimizer": "adam",
  "parameter_precision": "fp32",
  "precision": "fp32",
  "checkpoint_every": 3800,
  "extra_checkpoint_steps": [
    380,
    950,
    1900
  ],
  "log_every": 190,
  "seed": 42,
  "num_workers": 4
}
