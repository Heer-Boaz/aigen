{
  "format": "aigen.pix2pix.training.v2",
  "model": {
    "image_size": 128,
    "input_channels": 3,
    "output_channels": 3,
    "generator_channels": 448,
    "discriminator_channels": 64,
    "discriminator_layers": 3,
    "generator_dropout": true
  },
  "batch_size": 1,
  "max_steps": 2000,
  "learning_rate": 0.0002,
  "beta1": 0.5,
  "beta2": 0.999,
  "lambda_l1": 100.0,
  "horizontal_flip": true,
  "optimizer": "paged_adam8bit",
  "parameter_precision": "bf16",
  "precision": "bf16",
  "checkpoint_every": 500,
  "log_every": 50,
  "seed": 42,
  "num_workers": 4
}
